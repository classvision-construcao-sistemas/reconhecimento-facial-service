# Credenciais do cluster Zilliz Cloud (Milvus gerido)
ZILLIZ_URI=https://<seu-cluster>.serverless.<regiao>.cloud.zilliz.com
ZILLIZ_TOKEN=<seu-token-do-zilliz>
ZILLIZ_COLLECTION=Aluno

# Alternativa sem Zilliz: um Milvus próprio, sem token
# (docker-compose do ClassVision ou Milvus Lite num ficheiro local, só Linux/macOS).
# ZILLIZ_URI=http://localhost:19530
# ZILLIZ_URI=./milvus.db
# ZILLIZ_TOKEN=

# A coleção é criada automaticamente na primeira utilização (padrão: true).
# CRIAR_COLECAO_AUTOMATICAMENTE=true

# Porta HTTP (padrão 5000)
# PORT=5000

# Motor biométrico (opcional — os padrões estão em app/config/settings.py)
# LIMIAR_DETECCAO=0.6
# LIMIAR_RECONHECIMENTO=0.5
# MODELS_DIR=/caminho/para/models
# TOPOFR_ONNX_URL=https://.../topofr_r50_glint360k.onnx

# Autorização: o MESMO segredo JWT_SECRET do cv-authentication-service e do
# turma-service (mínimo 32 bytes; o cv-authentication-service exige 64).
JWT_SECRET=<mesmo-segredo-do-cv-authentication-service>

# Origens do app web liberadas no CORS (vírgula; "[*]" = qualquer porta).
# Padrão: só localhost. Ex.: http://localhost:[*],https://classvision.vercel.app
# CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
